# Vercel deploy excludes — keep diagnostic / dev-only artifacts out of the
# upload. Vercel does not reliably honor .gitignore for CLI uploads, so these
# are listed explicitly. None of these are needed to build or run the site.

# Performance trace dumps (100+ MB each — exceeds Vercel's 100 MB file limit)
perf-traces/

# Playwright MCP session artifacts (snapshots, console logs)
.playwright-mcp/

# Local performance tooling — not part of the build
scripts/perf-trace-record.mjs
scripts/perf-trace-analyze.mjs
scripts/perf-trace-deep.mjs
scripts/perf-trace-spike.mjs
scripts/perf-collector.js
scripts/perf-receiver.mjs
scripts/perf-throttle-test.mjs

# Diagnostic screenshots captured during perf work
perf-*.jpeg
post-fixes-*.jpeg

# Brainstorm / design docs — not needed at runtime
docs/superpowers/

# Local Claude worktrees
.claude/worktrees/
