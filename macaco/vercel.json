{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "lng",
          "value": "fr"
        }
      ],
      "destination": "/fr",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "lng",
          "value": "ko"
        }
      ],
      "destination": "/ko",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "lng",
          "value": "en"
        }
      ],
      "destination": "/en",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/games/wii-tanks/Build/(.*)\\.data\\.gz",
      "headers": [
        {
          "key": "Content-Encoding",
          "value": "gzip"
        },
        {
          "key": "Content-Type",
          "value": "application/octet-stream"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    },
    {
      "source": "/games/wii-tanks/Build/(.*)\\.wasm\\.gz",
      "headers": [
        {
          "key": "Content-Encoding",
          "value": "gzip"
        },
        {
          "key": "Content-Type",
          "value": "application/wasm"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    },
    {
      "source": "/games/wii-tanks/Build/(.*)\\.js\\.gz",
      "headers": [
        {
          "key": "Content-Encoding",
          "value": "gzip"
        },
        {
          "key": "Content-Type",
          "value": "application/javascript"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/games/wii-tanks",
      "destination": "/games/wii-tanks/index.html"
    },
    {
      "source": "/games/wii-tanks/",
      "destination": "/games/wii-tanks/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
