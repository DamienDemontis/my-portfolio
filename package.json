    "clsx": "^2.1.0",
    "tailwind-merge": "^2.5.0",
    "lucide-react": "^0.445.0",
    "openai": "^4.67.0",
    "marked": "^14.1.0",
    "dompurify": "^3.1.0",
    "react-intersection-observer": "^9.13.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
